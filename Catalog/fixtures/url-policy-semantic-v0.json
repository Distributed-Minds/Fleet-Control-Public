    },
    {
      "id": "embedded-space-host",
      "url": "https://exa mple.org/file",
      "expected_allowed": false,
      "reason": "malformed_host"
    },
    {
      "id": "encoded-newline-in-url",
      "url": "https://example.org/%0a",
      "expected_allowed": false,
      "reason": "encoded_control_character"
    },
    {
      "id": "encoded-cr-in-url",
      "url": "https://example.org/%0d",
      "expected_allowed": false,
      "reason": "encoded_control_character"
    }
  ]
}
