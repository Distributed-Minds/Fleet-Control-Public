{
  "fixture_schema": "free-energy.catalog-url-policy-semantic/v0",
  "target": "Catalog Rust offline external-URL admission (issue #60 specification v5)",
  "contract": "Semantic URI-policy vectors, not a Draft 2020-12 JSON Schema fragment. A string that passes a simple HTTPS regex may still fail this policy. Compare the eventual Rust URL validator's allow/deny output to expected_allowed; do not use expected_allowed to compute actual. No DNS lookup, network request, redirect following, rights verification or remote availability is established by this data.",
  "rules": [
    "HTTPS scheme only",
    "No userinfo or encoded credential delimiters",
    "Reject literal and obfuscated IP addresses, loopback/private/reserved hosts, and single-label hostnames",
    "Reject unexpected network ports, backslashes, malformed authorities, and control-byte encodings",
    "Syntax/admission acceptance is not evidence that a linked host is safe, reachable, rights-cleared or redirect-safe"
  ],
  "cases": [
    {
      "id": "public-github-https",
      "url": "https://github.com/luanti-org/luanti",
      "expected_allowed": true,
      "reason": "public_https"
    },
    {
      "id": "public-gitlab-https",
      "url": "https://gitlab.com/veloren/veloren",
      "expected_allowed": true,
      "reason": "public_https"
    },
    {
      "id": "public-codeberg-https",
      "url": "https://codeberg.org/example/project",
      "expected_allowed": true,
      "reason": "public_https"
    },
    {
      "id": "public-path-query-fragment",
      "url": "https://example.org/releases/v1.2?variant=linux#downloads",
      "expected_allowed": true,
      "reason": "public_https"
    },
    {
      "id": "public-percent-encoded-path",
      "url": "https://example.org/Project%20Files/readme",
      "expected_allowed": true,
      "reason": "public_https"
    },
    {
      "id": "http-not-https",
      "url": "http://example.org/download",
      "expected_allowed": false,
      "reason": "scheme_not_https"
    },
    {
      "id": "ftp-not-https",
      "url": "ftp://example.org/package",
      "expected_allowed": false,
      "reason": "scheme_not_https"
    },
    {
      "id": "scheme-relative-url",
      "url": "//example.org/download",
      "expected_allowed": false,
      "reason": "scheme_missing"
    },
    {
      "id": "javascript-scheme",
      "url": "javascript:alert(1)",
      "expected_allowed": false,
      "reason": "scheme_not_https"
    },
    {
      "id": "data-url",
      "url": "data:text/html,hello",
      "expected_allowed": false,
      "reason": "scheme_not_https"
    },
    {
      "id": "file-url",
      "url": "file:///etc/passwd",
      "expected_allowed": false,
      "reason": "scheme_not_https"
    },
    {
      "id": "missing-host",
      "url": "https:///download",
      "expected_allowed": false,
      "reason": "missing_authority"
    },
    {
      "id": "no-host-after-scheme",
      "url": "https://",
      "expected_allowed": false,
      "reason": "missing_authority"
    },
    {
      "id": "username-in-authority",
      "url": "https://user@example.org/path",
      "expected_allowed": false,
      "reason": "userinfo"
    },
    {
      "id": "password-in-authority",
      "url": "https://user:password@example.org/path",
      "expected_allowed": false,
      "reason": "userinfo"
    },
    {
      "id": "encoded-userinfo",
      "url": "https://user%40example.net@evil.org/path",
      "expected_allowed": false,
      "reason": "encoded_userinfo"
    },
    {
      "id": "encoded-at-sign-in-host",
      "url": "https://user%2540example.net@evil.org/path",
      "expected_allowed": false,
      "reason": "encoded_userinfo"
    },
    {
      "id": "backslash-as-authority-separator",
      "url": "https://example.org\\@evil.org/path",
      "expected_allowed": false,
      "reason": "backslash"
    },
    {
      "id": "encoded-backslash-in-authority",
      "url": "https://example.org%5c@evil.org/path",
      "expected_allowed": false,
      "reason": "encoded_delimiter"
    },
    {
      "id": "unexpected-external-port",
      "url": "https://example.org:8443/releases",
      "expected_allowed": false,
      "reason": "unexpected_port"
    },
    {
      "id": "ipv4-loopback",
