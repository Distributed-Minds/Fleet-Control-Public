{
  "fixture_schema": "free-energy.catalog-url-admission/v0",
  "target_schema": "Catalog/schema/project-v0.schema.json",
  "target_pointer": "#/$defs/url",
  "scope": "Semantic HTTPS URL admission for ALL external links in Catalog/projects manifests: upstream discovery/source/contribution/issue/mirrors, play upstream_download_url when non-null, and evidence.url/repository when non-null.",
  "description": "Deterministic URL parser and normalization cases for the pending compiled Rust validator (issue #60 spec v5). This is NOT a JSON Schema fragment acceptance oracle: the structural URL regex is intentionally insufficient. These expected results are semantic input-admission outcomes only, not proofs of DNS resolution, redirect safety, website liveness, download authenticity, code/asset rights or playability. Run offline: no DNS, HTTP, redirects or external fetching.",
  "cases": [
    {
      "id": "https-github",
      "url": "https://github.com/luanti-org/luanti",
      "expected_admitted": true,
      "reason": "Public DNS hostname and HTTPS, no credentials or explicit port"
    },
    {
      "id": "https-gitlab",
      "url": "https://gitlab.com/veloren/veloren",
      "expected_admitted": true,
      "reason": "Distinct public canonical development host"
    },
    {
      "id": "https-download-page",
      "url": "https://www.openra.net/download/",
      "expected_admitted": true,
      "reason": "Publisher download page link is syntactically admissible, not a verified playable artifact"
    },
    {
      "id": "https-pinned-file",
      "url": "https://github.com/luanti-org/luanti/blob/9a1b92d0d4d2c47fced18e6077722c6301eb04f5/LICENSE.txt",
      "expected_admitted": true,
      "reason": "Immutable revision path does not itself authenticate license or permission"
    },
    {
      "id": "https-host-case",
      "url": "https://GitHub.COM/luanti-org/luanti",
      "expected_admitted": true,
      "reason": "Host case normalizes without changing the HTTPS scheme or origin"
    },
    {
      "id": "https-fragment",
      "url": "https://github.com/luanti-org/luanti#readme",
      "expected_admitted": true,
      "reason": "Ordinary fragment is not an authority delimiter"
    },
    {
      "id": "https-query-encoding",
      "url": "https://github.com/search?q=game%20engine",
      "expected_admitted": true,
      "reason": "Encoded space in a path-independent query is not an authority credential"
    },
    {
      "id": "http-plaintext",
      "url": "http://github.com/luanti-org/luanti",
      "expected_admitted": false,
      "reason": "HTTP is not HTTPS"
    },
    {
      "id": "javascript-scheme",
      "url": "javascript:alert(1)",
      "expected_admitted": false,
      "reason": "Script scheme"
    },
    {
      "id": "file-scheme",
      "url": "file:///etc/passwd",
      "expected_admitted": false,
      "reason": "Local file access"
    },
    {
      "id": "userinfo-simple",
      "url": "https://user@github.com/repo",
      "expected_admitted": false,
      "reason": "Userinfo must be rejected before accepting a host"
    },
    {
      "id": "userinfo-password",
      "url": "https://user:password@github.com/repo",
      "expected_admitted": false,
      "reason": "Embedded userinfo secret"
    },
    {
      "id": "userinfo-percent-at",
      "url": "https://user%40example.com@github.com/repo",
      "expected_admitted": false,
      "reason": "Alternate-encoded userinfo before authority delimiter"
    },
    {
      "id": "authority-encoded-at",
      "url": "https://github.com%40internal.example/repo",
      "expected_admitted": false,
      "reason": "Percent-encoded at-sign in authority"
    },
    {
      "id": "authority-encoded-slash",
      "url": "https://github.com%2finternal.example/repo",
      "expected_admitted": false,
      "reason": "Percent-encoded separator in host"
    },
    {
      "id": "authority-encoded-backslash",
