    "contribution_url": "https://github.com/example/game/pulls",
    "issue_url": "https://github.com/example/game/issues",
    "read_only_mirror_urls": []
  },
  "cases": [
    {
      "id": "null-pin-explained",
      "overrides": {},
      "expected_valid": true
    },
    {
      "id": "null-pin-null-reason",
      "overrides": {
        "source_revision_reason": null
      },
      "expected_valid": false
    },
    {
      "id": "null-pin-empty-reason",
      "overrides": {
        "source_revision_reason": ""
      },
      "expected_valid": false
    },
    {
      "id": "null-pin-whitespace-reason",
      "overrides": {
        "source_revision_reason": "  "
      },
      "expected_valid": true
    },
    {
      "id": "null-pin-nonstring-reason",
      "overrides": {
        "source_revision_reason": 42
      },
      "expected_valid": false
    },
    {
      "id": "valid-pin-null-reason",
      "overrides": {
        "source_revision": "0123456789abcdef0123456789abcdef01234567",
