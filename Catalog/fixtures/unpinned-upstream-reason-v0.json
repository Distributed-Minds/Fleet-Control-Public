      "expected_valid": true
    },
    {
      "id": "valid-pin-empty-reason",
      "overrides": {
        "source_revision": "0123456789abcdef0123456789abcdef01234567",
        "source_revision_reason": ""
      },
      "expected_valid": true
    },
    {
      "id": "short-pin-explained",
      "overrides": {
        "source_revision": "deadbeef",
        "source_revision_reason": "not pinned"
      },
      "expected_valid": false
