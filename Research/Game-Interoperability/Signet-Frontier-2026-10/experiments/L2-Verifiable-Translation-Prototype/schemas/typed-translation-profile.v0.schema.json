{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://distributed-minds.example/schemas/typed-translation-profile.v0.schema.json",
  "title": "Typed translation profile research fixture v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "game", "translator", "entries"],
  "properties": {
    "schema": {"const": "typed-translation-profile@0"},
    "profile_id": {"type": "string", "minLength": 1},
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "translator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "semantic_profile_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "digest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/$defs/digest"}
        }
      },
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "baseEntry": {
      "type": "object",
      "required": ["id", "authority_class", "key", "pinned", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "authority_class": {
          "enum": ["INPUT_BINDING", "MOTION_OBSERVATION", "SEMANTIC_MAPPING", "APPEARANCE_MAPPING", "SESSION_POLICY"]
        },
        "key": {"type": "string", "minLength": 1},
        "pinned": {"type": "boolean"},
        "source": {
          "enum": ["player", "calibration", "translator_release", "server_session", "model_assisted_human_accepted"]
        },
        "notes": {"type": "string"}
      }
    },
    "entry": {
      "oneOf": [
        {"$ref": "#/$defs/inputBinding"},
        {"$ref": "#/$defs/motionObservation"},
        {"$ref": "#/$defs/semanticMapping"},
        {"$ref": "#/$defs/appearanceMapping"},
        {"$ref": "#/$defs/sessionPolicy"}
      ]
    },
    "inputBinding": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_class", "owner_scope", "control", "choice", "authoritative_effect"],
          "properties": {
            "id": {}, "key": {}, "pinned": {}, "source": {}, "notes": {},
            "authority_class": {"const": "INPUT_BINDING"},
            "owner_scope": {"const": "player"},
            "authoritative_effect": {"const": "indirect_permitted_intent"},
            "control": {"type": "string", "minLength": 1},
            "choice": {"type": "string", "minLength": 1},
            "device_fingerprint": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "motionObservation": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_class", "owner_scope", "authoritative_effect", "measurement", "integration_surface_digest"],
          "properties": {
            "id": {}, "key": {}, "pinned": {}, "source": {}, "notes": {},
            "authority_class": {"const": "MOTION_OBSERVATION"},
            "owner_scope": {"const": "adapter_evidence"},
            "authoritative_effect": {"const": "observation_only"},
            "measurement": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "unit", "method", "sample_count"],
              "properties": {
                "value": {"type": "number"},
                "unit": {"type": "string", "minLength": 1},
                "method": {"type": "string", "minLength": 1},
                "sample_count": {"type": "integer", "minimum": 1},
                "dispersion": {"type": "number", "minimum": 0}
              }
            },
            "conditions_digest": {"$ref": "#/$defs/digest"},
            "integration_surface_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "semanticMapping": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority_class", "owner_scope", "authoritative_effect", "choice", "status",
            "integration_surface_digest", "semantic_profile_digest", "transform_digest", "acceptance"
          ],
          "properties": {
            "id": {}, "key": {}, "pinned": {}, "source": {}, "notes": {},
            "authority_class": {"const": "SEMANTIC_MAPPING"},
            "owner_scope": {"const": "translator_release"},
            "authoritative_effect": {"const": "shared_state_possible"},
            "choice": {"type": "string", "minLength": 1},
            "status": {"enum": ["VALID", "SUSPECT", "REVALIDATING", "INVALID"]},
            "integration_surface_digest": {"$ref": "#/$defs/digest"},
            "semantic_profile_digest": {"$ref": "#/$defs/digest"},
            "transform_digest": {"$ref": "#/$defs/digest"},
            "candidate_set_digest": {"$ref": "#/$defs/digest"},
            "proposal": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method"],
              "properties": {
                "method": {"enum": ["human", "rules", "lookup", "model_assisted"]},
                "resolver_id": {"type": "string"},
                "resolver_version": {"type": "string"},
                "resolver_digest": {"$ref": "#/$defs/digest"},
                "score": {"type": "number"}
              }
            },
            "acceptance": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "replay_set_digest", "conformance_digest"],
              "properties": {
                "method": {"enum": ["replay_plus_conformance", "human_only", "conformance_only"]},
                "replay_set_digest": {"$ref": "#/$defs/digest"},
                "conformance_digest": {"$ref": "#/$defs/digest"},
                "accepted_by": {"type": "string"}
              }
            },
            "invalidates_on": {
              "type": "array",
              "items": {
                "enum": ["integration_surface_digest", "semantic_profile_digest", "transform_digest", "candidate_set_digest", "game_version"]
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "appearanceMapping": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_class", "owner_scope", "authoritative_effect", "choice"],
          "properties": {
            "id": {}, "key": {}, "pinned": {}, "source": {}, "notes": {},
            "authority_class": {"const": "APPEARANCE_MAPPING"},
            "owner_scope": {"const": "player_or_translator"},
            "authoritative_effect": {"const": "local_only"},
            "choice": {"type": "string", "minLength": 1},
            "palette_digest": {"$ref": "#/$defs/digest"},
            "candidate_scores": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidate", "score"],
                "properties": {
                  "candidate": {"type": "string", "minLength": 1},
                  "score": {"type": "number"}
                }
              }
            }
          }
        }
      ]
    },
    "sessionPolicy": {
      "allOf": [
        {"$ref": "#/$defs/baseEntry"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority_class", "owner_scope", "authoritative_effect", "choice", "ruleset_digest"],
          "properties": {
            "id": {}, "key": {}, "pinned": {}, "source": {}, "notes": {},
            "authority_class": {"const": "SESSION_POLICY"},
            "owner_scope": {"const": "server_session"},
            "authoritative_effect": {"const": "authoritative_policy"},
            "choice": {},
            "ruleset_digest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    }
  }
}